  "description": "Inject live-editable safety rules and a project-memory workflow into every DSH conversation.",
  "author": "Eu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c505016310-maker/dsh-safety-memory.git"
  },
